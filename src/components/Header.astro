---
import { nav, site } from '../site.config';

const path = Astro.url.pathname;
// Folder pages are part of the Writeups page, so they light up the same item.
const isCurrent = (href: string) =>
  href === '/'
    ? path === '/'
    : path.startsWith(href) || (href === '/writeups/' && path.startsWith('/folders/'));
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/">{site.title}</a>
    <nav class="site-nav" aria-label="Main">
      <!-- Opens the search pop-up (see SearchDialog.astro). Ctrl+K does the same. -->
      <button class="nav-search" type="button" data-search-open aria-label="Search write-ups">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <span>Search</span>
        <kbd>Ctrl K</kbd>
      </button>
      {
        nav.map((item) =>
          item.href ? (
            <a
              class="nav-link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ) : (
            <span class="nav-link nav-wip" title="Work in progress">
              {item.label}
            </span>
          )
        )
      }
    </nav>
  </div>
</header>
