---
// One folder in the folder list, with the folders and write-ups inside it.
import { type FolderNode, writeupSlug, writeupUrl } from '../lib/writeups';

interface Props {
  node: FolderNode;
  /** Address name of the write-up being shown, to mark it in the list. */
  currentSlug?: string;
  /** Folders that start open because the page being shown is inside them. */
  openPaths: string[];
  /** The folder whose own page is being shown, to mark it in the list. */
  currentFolder?: string;
  depth?: number;
}

const { node, currentSlug, openPaths, currentFolder, depth = 0 } = Astro.props;
const onPath = openPaths.includes(node.path);
---

<details
  class="tree-folder"
  data-folder={node.path}
  data-on-path={onPath ? '' : undefined}
  open={depth === 0 || onPath}
>
  <summary class:list={['tree-summary', { current: currentFolder === node.path }]}>
    <span class="tree-name">{node.name}</span>
    <span class="count">{node.count}</span>
  </summary>
  <div class="tree-children">
    {
      node.folders.map((child) => (
        <Astro.self
          node={child}
          currentSlug={currentSlug}
          openPaths={openPaths}
          currentFolder={currentFolder}
          depth={depth + 1}
        />
      ))
    }
    {
      node.entries.length > 0 && (
        <ul class="tree-list">
          {node.entries.map((entry) => (
            <li>
              <a
                class="tree-link"
                href={writeupUrl(entry)}
                aria-current={writeupSlug(entry) === currentSlug ? 'page' : undefined}
              >
                {entry.data.title}
                {entry.data.draft && <span class="badge">Draft</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</details>
