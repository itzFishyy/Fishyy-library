---
// One write-up on the Writeups page: folder list on the left, the write-up
// in the middle and its contents list on the right.
import { render } from 'astro:content';
import Library from '../layouts/Library.astro';
import FolderPath from './FolderPath.astro';
import WriteupRow from './WriteupRow.astro';
import {
  type Writeup,
  categoryUrl,
  foldersOf,
  formatDate,
  readingTime,
  tagUrl,
  writeupSlug,
  writeupUrl,
} from '../lib/writeups';

interface Props {
  entry: Writeup;
  newer: Writeup | null;
  older: Writeup | null;
  related: Writeup[];
}

const { entry, newer, older, related } = Astro.props;
const { title, category, tags, date, difficulty, description, draft } = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const folders = foldersOf(entry);
---

<Library
  title={title}
  description={description}
  currentSlug={writeupSlug(entry)}
  openPath={folders.at(-1)?.path}
>
  <div class:list={['post', { 'has-toc': toc.length > 0 }]}>
    {
      toc.length > 0 && (
        <nav class="toc toc-side" aria-label="Table of contents">
          <p class="toc-title">Contents</p>
          <ol>
            {toc.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article>
      <header class="post-header">
        <FolderPath folders={folders} />
        <h1>
          {title}
          {draft && <span class="badge">Draft</span>}
        </h1>
        <p class="meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <a href={categoryUrl(category)}>{category}</a>
          {difficulty && <span>{difficulty}</span>}
          <span>{readingTime(entry)}</span>
        </p>
        {
          tags.length > 0 && (
            <ul class="tags">
              {tags.map((tag) => (
                <li>
                  <a class="tag" href={tagUrl(tag)}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        // The same contents list, folded into a box, for screens too narrow for a third column.
        toc.length > 0 && (
          <details class="toc toc-inline">
            <summary class="toc-title">Contents</summary>
            <ol>
              {toc.map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        (newer || older) && (
          <nav class="post-nav" aria-label="More write-ups">
            {older ? (
              <a class="prev" href={writeupUrl(older)}>
                <small>← Older</small>
                {older.data.title}
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="next" href={writeupUrl(newer)}>
                <small>Newer →</small>
                {newer.data.title}
              </a>
            )}
          </nav>
        )
      }

      {
        related.length > 0 && (
          <section class="related">
            <h2 class="section-title">Related write-ups</h2>
            <ul class="row-list">
              {related.map((other) => (
                <li>
                  <WriteupRow entry={other} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </div>
</Library>
