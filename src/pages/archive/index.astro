---
// The logbook: every write-up by date, one short line each, grouped by
// year and month so the whole history can be read at a glance.
import Base from '../../layouts/Base.astro';
import {
  type Writeup,
  categoryUrl,
  folderUrl,
  getWriteups,
  sourceOf,
  writeupUrl,
} from '../../lib/writeups';

interface Month {
  name: string;
  entries: Writeup[];
}

interface Year {
  year: number;
  count: number;
  months: Month[];
}

const writeups = await getWriteups();

// Write-ups arrive newest first, so years and months come out newest first too.
const years: Year[] = [];
for (const entry of writeups) {
  const date = entry.data.date;
  const yearNumber = date.getUTCFullYear();
  const monthName = date.toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });

  let year = years.at(-1);
  if (!year || year.year !== yearNumber) {
    year = { year: yearNumber, count: 0, months: [] };
    years.push(year);
  }
  let month = year.months.at(-1);
  if (!month || month.name !== monthName) {
    month = { name: monthName, entries: [] };
    year.months.push(month);
  }
  year.count += 1;
  month.entries.push(entry);
}

const plural = (count: number) => `${count} ${count === 1 ? 'write-up' : 'write-ups'}`;
---

<Base title="Archive">
  <div class="container">
    <h1 class="page-title">Archive</h1>
    <p class="page-subtitle">{plural(writeups.length)}, newest first</p>

    {writeups.length === 0 && <p class="empty">No write-ups yet.</p>}

    {
      years.length > 1 && (
        <nav class="log-years" aria-label="Years">
          {years.map((year) => (
            <a class="tag" href={`#year-${year.year}`}>
              {year.year}
            </a>
          ))}
        </nav>
      )
    }

    {
      years.map((year) => (
        <section class="log-year" id={`year-${year.year}`}>
          <h2 class="section-title">
            {year.year}
            <span class="count">{plural(year.count)}</span>
          </h2>
          {year.months.map((month) => (
            <div class="log-month">
              <h3 class="log-month-title">
                {month.name}
                <span class="count">{month.entries.length}</span>
              </h3>
              <ul class="log-list">
                {month.entries.map((entry) => {
                  const source = sourceOf(entry);
                  return (
                    <li class="log-line">
                      <time class="log-day" datetime={entry.data.date.toISOString()}>
                        {String(entry.data.date.getUTCDate()).padStart(2, '0')}
                      </time>
                      <a class="log-title" href={writeupUrl(entry)}>
                        {entry.data.title}
                        {entry.data.draft && <span class="badge">Draft</span>}
                      </a>
                      <span class="log-meta">
                        {source && <a href={folderUrl(source.path)}>{source.label}</a>}
                        <a href={categoryUrl(entry.data.category)}>{entry.data.category}</a>
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</Base>
