---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import WriteupPage from '../../components/WriteupPage.astro';
import { type Writeup, getHiddenDrafts, getRelated, getWriteups } from '../../lib/writeups';

export const getStaticPaths = (async () => {
  const writeups = await getWriteups();
  const published = writeups.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      hidden: false,
      newer: (writeups[index - 1] ?? null) as Writeup | null,
      older: (writeups[index + 1] ?? null) as Writeup | null,
      related: getRelated(entry, writeups),
    },
  }));
  // Hidden drafts keep their address but show only a notice (see getHiddenDrafts).
  const hidden = (await getHiddenDrafts()).map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      hidden: true,
      newer: null as Writeup | null,
      older: null as Writeup | null,
      related: [] as Writeup[],
    },
  }));
  return [...published, ...hidden];
}) satisfies GetStaticPaths;

const { entry, hidden, newer, older, related } = Astro.props;
---

{
  hidden ? (
    <Base title="Write-up not available" noindex>
      <div class="container narrow">
        <h1 class="page-title">This write-up isn't available</h1>
        <p>
          It isn't published right now. <a href="/">Back to the library</a>.
        </p>
      </div>
    </Base>
  ) : (
    <WriteupPage entry={entry} newer={newer} older={older} related={related} />
  )
}
