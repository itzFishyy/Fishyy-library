---
import type { GetStaticPaths } from 'astro';
import GroupPage from '../../components/GroupPage.astro';
import { getWriteups, groupBySource } from '../../lib/writeups';

export const getStaticPaths = (async () => {
  return groupBySource(await getWriteups()).map((group) => ({
    params: { source: group.slug },
    props: { group },
  }));
}) satisfies GetStaticPaths;
---

<GroupPage kind="Source" group={Astro.props.group} showSource={false} />
