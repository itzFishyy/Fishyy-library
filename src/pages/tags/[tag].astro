---
import type { GetStaticPaths } from 'astro';
import GroupPage from '../../components/GroupPage.astro';
import { getWriteups, groupByTag } from '../../lib/writeups';

export const getStaticPaths = (async () => {
  return groupByTag(await getWriteups()).map((group) => ({
    params: { tag: group.slug },
    props: { group },
  }));
}) satisfies GetStaticPaths;
---

<GroupPage kind="Tag" group={Astro.props.group} />
