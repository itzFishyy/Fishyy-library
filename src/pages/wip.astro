---
import Base from '../layouts/Base.astro';
import { wip } from '../site.config';

const progress = Math.min(100, Math.max(0, wip.progress));
---

<Base title="????">
  <div class="container narrow wip">
    <p class="wip-mark" aria-hidden="true">????</p>
    <h1 class="page-title">{wip.heading}</h1>
    {wip.lines.map((line) => <p>{line}</p>)}

    <div class="wip-progress">
      {wip.label && <span class="wip-label">{wip.label}</span>}
      <div
        class="wip-bar"
        role="progressbar"
        aria-label={wip.label || 'Progress'}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={progress}
      >
        <div class="wip-bar-fill" style={`width: ${progress}%`}></div>
      </div>
      <span class="muted">{progress}%</span>
    </div>
  </div>
</Base>
